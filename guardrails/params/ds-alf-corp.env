# =============================================================================
# Paramètres du SNO ds.alf.corp (maquette AiDocs) — valeurs réellement appliquées.
# =============================================================================
GR_NAMESPACE=guardrails-demo

# LLM : Granite 3.3 2B servi par le LLMInferenceService llm-d « granite-llmd »
# (depuis le 2026-10-29 ; l'ISVC qwen-gpu est arrêté, un seul GPU sur le nœud).
# Service interne du workload, sans authentification (enable-auth: false), TLS service-ca.
LLM_NAMESPACE=alf-test
LLM_ISVC_NAME=granite-llmd
LLM_MODEL_NAME=granite-3-3-2b
LLM_BASE_URL=https://granite-llmd-kserve-workload-svc.alf-test.svc.cluster.local:8000/v1
# Inutile pour granite-llmd (pas d'auth) ; conservé pour revenir sur qwen-gpu.
# Role créé à la main le 2026-09-04 ; équivalent du « qwen-gpu-view-role » du dashboard
LLM_CALLER_ROLE=qwen-gpu-inference-caller

OWUI_NAMESPACE=aidocs
OWUI_SA=open-webui
OWUI_TOKEN_SECRET=open-webui-token

# Le poste ne résout pas *.apps par joker (entrées /etc/hosts une par une)
ROUTE_IP=192.168.100.101
