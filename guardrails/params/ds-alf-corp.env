# =============================================================================
# Paramètres du SNO ds.alf.corp (maquette AiDocs) — valeurs réellement appliquées.
# =============================================================================
GR_NAMESPACE=guardrails-demo

# LLM : Granite 3.3 2B servi sous le nom « qwen-gpu » (nom historique conservé)
LLM_NAMESPACE=alf-test
LLM_ISVC_NAME=qwen-gpu
LLM_MODEL_NAME=qwen-gpu
LLM_BASE_URL=https://qwen-gpu-predictor.alf-test.svc.cluster.local:8443/v1
# Role créé à la main le 2026-09-04 ; équivalent du « qwen-gpu-view-role » du dashboard
LLM_CALLER_ROLE=qwen-gpu-inference-caller

OWUI_NAMESPACE=aidocs
OWUI_SA=open-webui
OWUI_TOKEN_SECRET=open-webui-token

# Le poste ne résout pas *.apps par joker (entrées /etc/hosts une par une)
ROUTE_IP=192.168.100.101
