# =============================================================================
# Paramètres d'un environnement cible — copier en <mon-cluster>.env et adapter.
# Toutes les valeurs sont obligatoires pour le rendu (../render.sh).
# =============================================================================

# --- Projet qui héberge NeMo Guardrails (à créer depuis le dashboard OpenShift AI)
GR_NAMESPACE=guardrails-demo

# --- LLM à protéger (InferenceService vLLM avec « Require token authentication »)
# Projet (Data Science Project) du modèle
LLM_NAMESPACE=mon-projet-llm
# Nom de l'InferenceService
LLM_ISVC_NAME=mon-llm
# Nom de modèle servi par vLLM : c'est l'« id » renvoyé par GET /v1/models
LLM_MODEL_NAME=mon-llm
# URL interne OpenAI du prédicteur, terminée par /v1. En RawDeployment avec
# authentification : https://<isvc>-predictor.<projet>.svc.cluster.local:8443/v1
# (vérifier le port : oc get svc <isvc>-predictor -n <projet>)
LLM_BASE_URL=https://mon-llm-predictor.mon-projet-llm.svc.cluster.local:8443/v1
# Role qui autorise l'appel du modèle (get sur l'InferenceService). Le dashboard le
# crée quand on coche « Require token authentication » : <isvc>-view-role
LLM_CALLER_ROLE=mon-llm-view-role

# --- Client de démonstration autorisé à appeler NeMo (Open WebUI)
OWUI_NAMESPACE=mon-projet-app
OWUI_SA=open-webui
OWUI_TOKEN_SECRET=open-webui-token

# --- Recette (tests/recette.py)
# IP d'entrée des routes (*.apps) si le poste ne résout pas le nom de la Route ;
# laisser vide si le DNS résout.
ROUTE_IP=
